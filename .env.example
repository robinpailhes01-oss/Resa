# ---- Configuration commerciale (source unique, cahier des charges §2) ----
# prelaunch (défaut, liste d'attente) ou live (inscription et connexion ouvertes sur /inscription et /connexion).
RESO_LAUNCH_MODE=prelaunch
RESO_MONTHLY_PRICE_EX_VAT=39
RESO_PRACTITIONER_LIMIT=3
# Durée de l'essai gratuit en jours (7 par défaut ; 0 pour désactiver l'essai).
RESO_TRIAL_DAYS=7
# Facultatif en mode live : par défaut /inscription et /connexion (pages intégrées). Chemins internes ou URLs HTTPS absolues.
RESO_SIGNUP_URL=
RESO_LOGIN_URL=
# Adresse de contact surveillée (footer, mentions légales, Reply-To).
RESO_SUPPORT_EMAIL=
# Identité légale de l'éditeur et hébergeur (pages légales).
RESO_LEGAL_ENTITY=
RESO_PUBLICATION_DIRECTOR=
RESO_HOSTING_PROVIDER=
# Version de la politique de confidentialité enregistrée avec chaque demande.
RESO_PRIVACY_VERSION=2026-09-18
# Origine publique du site (canonical, liens absolus des emails, contrôle d'origine).
RESO_SITE_URL=http://localhost:3000
# true uniquement en production validée : autorise l'indexation.
RESO_INDEXABLE=false

# ---- Import de la fiche Google (onboarding) ----
# Clé Google Cloud avec l'API « Places API (New) » activée. Sans clé, le bloc d'import n'apparaît pas.
GOOGLE_PLACES_API_KEY=

# ---- Persistance ----
# PostgreSQL (Supabase, Neon, serveur local…), requis pour l'application (comptes, établissements, rendez-vous).
# Sur Vercel, l'intégration Supabase du marketplace injecte POSTGRES_URL, acceptée à la place de DATABASE_URL.
# Les migrations s'appliquent au build (ou avec `npm run db:migrate`). Sans base, seule la landing fonctionne
# (liste d'attente dans .data/waitlist.json en développement, 503 en production).
DATABASE_URL=
# Base dédiée aux tests d'intégration (`npm test`), migrée elle aussi. Facultatif.
TEST_DATABASE_URL=
# Fichier de développement (facultatif).
# WAITLIST_FILE=.data/waitlist.json

# ---- Email ----
# console : écrit les emails dans le journal serveur (recette locale uniquement).
# EMAIL_PROVIDER=console
# Resend : clé API + expéditeur sur un domaine configuré (SPF, DKIM, DMARC).
RESEND_API_KEY=
EMAIL_FROM="Reso <bonjour@votre-domaine.fr>"

# ---- Notifications Telegram (équipe Reso) ----
# Bot créé avec @BotFather ; identifiant de votre conversation avec le bot (voir docs/deploiement.md, partie 9).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Exploitation ----
# Secret des routes internes appelées par un cron (Authorization: Bearer …) :
# /api/internal/email-jobs (rappels et emails de rendez-vous, toutes les 5 à 15 min),
# /api/internal/email-tasks (rejeu liste d'attente), /api/internal/purge (quotidien).
INTERNAL_TASKS_SECRET=
# Webhook d'alerte (Slack, Discord…) : POST JSON { text, meta }.
ALERT_WEBHOOK_URL=
# Anti-abus (valeurs initiales §13).
RATE_LIMIT_IP_MAX=5
RATE_LIMIT_IP_WINDOW_MIN=15
RATE_LIMIT_EMAIL_MAX=3
# Purge (propositions à valider §15).
WAITLIST_PENDING_RETENTION_DAYS=7
WAITLIST_CONFIRMED_RETENTION_MONTHS=12
